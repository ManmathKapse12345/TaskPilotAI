# ---- LLM (optional) -------------------------------------------------------
# Without a key TaskPilot still works: rule-based intent parsing + extractive summaries.
# auto = use Gemini if GEMINI_API_KEY is set, else OpenAI if OPENAI_API_KEY is set, else none
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30

# ---- Execution limits -----------------------------------------------------
DEFAULT_MAX_PAGES=5
MAX_PAGES_LIMIT=10
MAX_DEPTH_LIMIT=2
CLI_TIMEOUT_SECONDS=90
MAX_CONCURRENT_TASKS=3
MAX_PROMPT_CHARS=2000

# ---- Infrastructure -------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/taskpilot   (default: SQLite file)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
